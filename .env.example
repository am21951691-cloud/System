# Environment variables for Medical Complex System
# Required for both local and production deployment

# Database
# Local development with SQLite:
DATABASE_URL="file:./data/clinic.db"

# Production with PostgreSQL (uncomment and modify for production):
# DATABASE_URL="postgresql://admin:password@db.example.com:5432/clinic?sslmode=require"

# Authentication
# Secret key for JWT token signing - MUST change this for production!
# Generate with: openssl rand -hex 32
JWT_SECRET="clinic-secret-key-change-in-production"

# Application settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Cloudflare Deployment URL:
# NEXT_PUBLIC_APP_URL="https://medical-system.pages.dev"
# Or your custom domain behind Cloudflare:
# NEXT_PUBLIC_APP_URL="https://clinic.yourdomain.com"